---
// 分类页面
import Layout from '../layouts/Layout.astro';
import { siteConfig } from '../config/site';
import { getCollection } from 'astro:content';

// 获取所有文章
const allPosts = await getCollection('blog');

// 生成分类数据
const categoryMap = new Map();
allPosts.forEach(post => {
  const category = post.data.series || '未分类';
  if (categoryMap.has(category)) {
    categoryMap.set(category, categoryMap.get(category) + 1);
  } else {
    categoryMap.set(category, 1);
  }
});

const categories = Array.from(categoryMap.entries())
  .map(([name, count]) => ({
    name,
    slug: name.toLowerCase().split(' ').join('-'),
    count
  }))
  .sort((a, b) => b.count - a.count);

// 生成标签数据
const tagMap = new Map();
allPosts.forEach(post => {
  if (post.data.tags && post.data.tags.length > 0) {
    post.data.tags.forEach(tag => {
      if (tagMap.has(tag)) {
        tagMap.set(tag, tagMap.get(tag) + 1);
      } else {
        tagMap.set(tag, 1);
      }
    });
  }
});

const tags = Array.from(tagMap.entries())
  .map(([name, count]) => ({
    name,
    slug: name.toLowerCase().split(' ').join('-'),
    count
  }))
  .sort((a, b) => b.count - a.count);

// 生成归档数据
const archiveMap = new Map();
allPosts.forEach(post => {
  if (post.data.timestamp) {
    const date = new Date(post.data.timestamp);
    const year = date.getFullYear();
    const month = (date.getMonth() + 1).toString();
    
    if (!archiveMap.has(year)) {
      archiveMap.set(year, new Map());
    }
    
    const yearMap = archiveMap.get(year);
    if (yearMap.has(month)) {
      yearMap.set(month, yearMap.get(month) + 1);
    } else {
      yearMap.set(month, 1);
    }
  }
});

const archiveData = Array.from(archiveMap.entries())
  .map(([year, monthMap]) => ({
    year,
    months: Array.from(monthMap.entries())
      .map(([month, count]) => ({ month, count }))
      .sort((a, b) => parseInt(b.month) - parseInt(a.month))
  }))
  .sort((a, b) => b.year - a.year);
---

<Layout title="Category - Hacker Theme">
  <div class="category-page">
    <section class="category-section">
      <h2 class="section-title">文章归档</h2>
      <div class="archive-list">
        {archiveData.map((year) => (
          <div class="archive-year">
            <h3 class="year-title">{year.year} 年</h3>
            <div class="month-list">
              {year.months.map((month) => (
                <a href={`/archive/${year.year}/${month.month}`} class="month-item">
                  <span class="month-name">{month.month} 月</span>
                  <span class="month-count">({month.count})</span>
                </a>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <section class="category-section">
      <h2 class="section-title">文章分类</h2>
      <div class="category-list">
        {categories.map((category) => (
          <a href={`/category/${category.slug}`} class="category-item">
            <span class="category-name">{category.name}</span>
            <span class="category-count">({category.count})</span>
          </a>
        ))}
      </div>
    </section>

    <section class="category-section">
      <h2 class="section-title">标签云</h2>
      <div class="tag-list">
        {tags.map((tag) => (
          <a href={`/tag/${tag.slug}`} class="tag-item">
            {tag.name}
            <span class="tag-count">{tag.count}</span>
          </a>
        ))}
      </div>
    </section>
  </div>
</Layout>

<style>
  .category-page {
    padding: 2rem 0;
  }
  
  .category-section {
    margin-bottom: 3rem;
  }
  
  .section-title {
    font-size: 1.5rem;
    color: #212121;
    text-align: center;
    margin-bottom: 1.5rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid #e0e0e0;
  }
  
  .archive-year {
    margin-bottom: 1.5rem;
  }
  
  .year-title {
    font-size: 1.2rem;
    color: #424242;
    margin-bottom: 1rem;
  }
  
  .month-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding-left: 1rem;
  }
  
  .month-item {
    display: inline-flex;
    gap: 0.25rem;
    padding: 0.25rem 0.75rem;
    background-color: #f5f5f5;
    border-radius: 3px;
    color: #616161;
    font-size: 0.9rem;
    transition: all 0.2s ease;
  }
  
  .month-item:hover {
    background-color: #F03838;
    color: #fff;
  }
  
  .month-count {
    color: #9e9e9e;
    font-size: 0.8rem;
  }
  
  .month-item:hover .month-count {
    color: #fff;
  }
  
  .category-list {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: center;
  }
  
  .category-item {
    display: inline-flex;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    background-color: #f5f5f5;
    border-radius: 3px;
    color: #424242;
    transition: all 0.2s ease;
  }
  
  .category-item:hover {
    background-color: #F03838;
    color: #fff;
  }
  
  .category-count {
    color: #9e9e9e;
  }
  
  .category-item:hover .category-count {
    color: #fff;
  }
  
  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: center;
  }
  
  .tag-item {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.375rem 0.75rem;
    background-color: #fafafa;
    border: 1px solid #e0e0e0;
    border-radius: 20px;
    color: #616161;
    font-size: 0.9rem;
    transition: all 0.2s ease;
  }
  
  .tag-item:hover {
    background-color: #F03838;
    border-color: #F03838;
    color: #fff;
  }
  
  .tag-count {
    font-size: 0.75rem;
    color: #9e9e9e;
    background-color: #e0e0e0;
    padding: 0.1rem 0.4rem;
    border-radius: 10px;
  }
  
  .tag-item:hover .tag-count {
    background-color: rgba(255, 255, 255, 0.3);
    color: #fff;
  }
</style>
