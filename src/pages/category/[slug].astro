---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const allPosts = await getCollection('blog');
  const categories = new Set();
  
  allPosts.forEach(post => {
    const category = post.data.series || '未分类';
    categories.add(category);
  });
  
  const paths = [];
  categories.forEach(category => {
    let slug = category.toLowerCase();
    slug = slug.split(' ').join('-');
    paths.push({
      params: { slug },
      props: { category }
    });
  });
  
  return paths;
}

const { category } = Astro.props;
const allPosts = await getCollection('blog');
const posts = allPosts.filter(post => post.data.series === category);
---

<Layout title={`分类: ${category}`}>
  <div class="category-posts">
    <h1 class="category-title">分类: {category}</h1>
    <p class="category-description">共 {posts.length} 篇文章</p>
    
    <div class="blog">
      {posts.map(post => {
        const timestamp = post.data.timestamp;
        return (
          <article class="Article">
            <h2 class="Article__title"><a href={`/post/${post.slug}`}><span>{post.data.title}</span></a></h2>
            <div class="Article__topMeta">
              <span class="entry-date"><time datetime={timestamp ? timestamp.toISOString() : ''}>
                {timestamp ? timestamp.toLocaleDateString('zh-CN', {
                  year: 'numeric',
                  month: 'long',
                  day: 'numeric'
                }) : '未知时间'}
              </time></span>
            </div>
          </article>
        );
      })}
    </div>
  </div>
</Layout>

<style>
  .category-posts {
    padding: 2rem 0;
  }
  
  .category-title {
    font-size: 2rem;
    color: #212121;
    text-align: center;
    margin-bottom: 0.5rem;
  }
  
  .category-description {
    text-align: center;
    color: #616161;
    margin-bottom: 2rem;
  }
  
  .blog {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  
  .Article {
    padding: 1rem 0;
    border-bottom: 1px solid #e0e0e0;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  
  .Article:last-child {
    border-bottom: none;
  }
  
  .Article__title {
    margin: 0;
    font-size: 1.2rem;
    flex: 1;
  }
  
  .Article__title a {
    color: #212121;
    text-decoration: none;
  }
  
  .Article__title a:hover {
    color: #F03838;
  }
  
  .Article__topMeta {
    font-size: 0.9rem;
    color: #616161;
    margin-left: 1rem;
    white-space: nowrap;
  }
</style>