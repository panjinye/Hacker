---
// 首页
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const pageSize = 5;

// 生成摘要：如果没有摘要，使用文章前100字左右，截止到最后一个句号
const generateExcerpt = (content, maxLength = 100) => {
  // 去除Markdown格式
  const plainText = content
    .replace(/\n/g, ' ') // 替换换行
    .replace(/\[([^\]]+)\]\([^)]+\)/g, '$1') // 移除链接
    .replace(/[#*`_\[\]()]/g, ''); // 移除Markdown标记
  
  // 如果内容长度小于maxLength，直接返回
  if (plainText.length <= maxLength) {
    return plainText;
  }
  
  // 截取前maxLength字
  const truncated = plainText.substring(0, maxLength);
  
  // 找到最后一个句号
  const lastPeriodIndex = truncated.lastIndexOf('。');
  
  // 如果找到句号，截止到句号处
  if (lastPeriodIndex > maxLength * 0.7) { // 确保句号在合理范围内
    return truncated.substring(0, lastPeriodIndex + 1) + '...';
  }
  
  // 否则直接截取maxLength字
  return truncated + '...';
};

const allPosts = await getCollection('blog');
const sortedPosts = allPosts
  .sort((a, b) => {
    if (!a.data.timestamp || !b.data.timestamp) return 0;
    return b.data.timestamp.valueOf() - a.data.timestamp.valueOf();
  });

const totalPosts = sortedPosts.length;
const totalPages = Math.ceil(totalPosts / pageSize);
---

<Layout title="Hacker Theme">
  <div class="blog">
    {sortedPosts.map((post, index) => {
      const timestamp = post.data.timestamp;
      const series = post.data.series || '未分类';
      
      const excerpt = post.data.excerpt || generateExcerpt(post.body);
      
      return (
        <article class="Article" data-index="${index}">
          <h2 class="Article__title Article__title--large"><a href={`/post/${post.slug}`}><span>{post.data.title}</span></a></h2>
          <div class="Article__topMeta">
            <span class="entry-date"><time datetime={timestamp ? timestamp.toISOString() : ''}>
              {timestamp ? timestamp.toLocaleDateString('zh-CN', {
                year: 'numeric',
                month: 'long',
                day: 'numeric'
              }) : '未知时间'}
            </time></span>
            <span class="by-author">by <a href="#">Admin</a></span>
          </div>
          <div class="Article__excerpt">
            <p>{excerpt || '暂无摘要'}</p>
          </div>
          <div class="Article__footer">
            <div class="Article__meta">
              <span class="post-tags">
                {post.data.tags && post.data.tags.length > 0 && post.data.tags.map(tag => {
                  const tagSlug = tag.toLowerCase().split(' ').join('-');
                  return <a href={`/tag/${tagSlug}`}>{tag}</a>;
                })}
              </span>
            </div>
          </div>
        </article>
      );
    })}
  </div>
  
  {totalPages > 1 && (
    <div class="pagination">
      <button class="pagination__link" data-page="prev" title="上一页">
        <i class="fas fa-chevron-left"></i>
      </button>
      {Array.from({ length: totalPages }, (_, i) => i + 1).map(num => (
        <button key={num} class="pagination__link" data-page={num}>{num}</button>
      ))}
      <button class="pagination__link" data-page="next" title="下一页">
        <i class="fas fa-chevron-right"></i>
      </button>
    </div>
  )}
  
  <script>
    // 分页功能
    const pageSize = 5;
    
    // 获取当前页码
    function getCurrentPage() {
      const urlParams = new URLSearchParams(window.location.search);
      return parseInt(urlParams.get('page') || '1');
    }
    
    // 显示指定页面的文章
    function showPage(page) {
      const articles = document.querySelectorAll('.Article');
      const startIndex = (page - 1) * pageSize;
      const endIndex = startIndex + pageSize;
      
      articles.forEach((article, index) => {
        if (index >= startIndex && index < endIndex) {
          article.style.display = 'block';
        } else {
          article.style.display = 'none';
        }
      });
      
      // 更新分页按钮状态
      const buttons = document.querySelectorAll('.pagination__link');
      buttons.forEach(button => {
        const buttonPage = parseInt(button.getAttribute('data-page'));
        if (buttonPage === page) {
          button.classList.add('pagination__link--active');
        } else {
          button.classList.remove('pagination__link--active');
        }
      });
      
      // 更新URL
      window.history.pushState({}, '', `/?page=${page}`);
    }
    
    // 绑定分页按钮事件
    document.querySelectorAll('.pagination__link').forEach(button => {
      button.addEventListener('click', () => {
        const pageData = button.getAttribute('data-page');
        if (pageData === 'prev') {
          const currentPage = getCurrentPage();
          if (currentPage > 1) {
            showPage(currentPage - 1);
          }
        } else if (pageData === 'next') {
          const currentPage = getCurrentPage();
          if (currentPage < 10) { // 假设最多10页
            showPage(currentPage + 1);
          }
        } else {
          const page = parseInt(pageData);
          showPage(page);
        }
      });
    });
    
    // 初始化
    showPage(getCurrentPage());
  </script>
</Layout>

<style>
  .Article__title--large {
    font-size: 1.5em;
  }
  
  .pagination {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.5rem;
    margin-top: 2rem;
    padding-top: 2rem;
    border-top: 1px solid #e0e0e0;
  }
  
  .pagination__link {
    padding: 0.5rem 1rem;
    background-color: #f5f5f5;
    color: #212121;
    text-decoration: none;
    border-radius: 3px;
    transition: all 0.2s ease;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 40px;
    text-align: center;
  }
  
  .pagination__link:hover {
    background-color: #F03838;
    color: #fff;
  }
  
  .pagination__link--active {
    background-color: #F03838;
    color: #fff;
  }
</style>