---
// Footer组件
import { siteConfig } from '../config/site';

const currentYear = new Date().getFullYear();
const buildDate = new Date(siteConfig.buildDate);
const startYear = buildDate.getFullYear();
const now = new Date();
const daysRunning = Math.floor((now.getTime() - buildDate.getTime()) / (1000 * 60 * 60 * 24));

const targetDate = new Date(buildDate.getFullYear() + 10, 0, 1);
const daysRemaining = Math.ceil((targetDate.getTime() - now.getTime()) / (1000 * 60 * 60 * 24));
---

<footer class="site-footer">
  <div class="footer-social">
    {siteConfig.social.github && (
      <a href={siteConfig.social.github} target="_blank" rel="noopener noreferrer" class="social-icon" title="GitHub">
        <i class="fab fa-github"></i>
      </a>
    )}
    {siteConfig.social.twitter && (
      <a href={siteConfig.social.twitter} target="_blank" rel="noopener noreferrer" class="social-icon" title="Twitter">
        <i class="fab fa-twitter"></i>
      </a>
    )}
    {siteConfig.social.mastodon && (
      <a href={siteConfig.social.mastodon} target="_blank" rel="noopener noreferrer" class="social-icon" title="Mastodon">
        <i class="fab fa-mastodon"></i>
      </a>
    )}
    {siteConfig.social.qq && (
      <a href={siteConfig.social.qq} target="_blank" rel="noopener noreferrer" class="social-icon" title="QQ">
        <i class="fab fa-qq"></i>
      </a>
    )}
    {siteConfig.social.email && (
      <a href={siteConfig.social.email} class="social-icon" title="Email">
        <i class="fas fa-envelope"></i>
      </a>
    )}
    {siteConfig.social.rss && (
      <a href={siteConfig.social.rss} class="social-icon" title="RSS">
        <i class="fas fa-rss"></i>
      </a>
    )}
    
    <button id="theme-toggle" class="social-icon" title="切换主题">
      <i class="fas fa-moon"></i>
      <i class="fas fa-sun"></i>
    </button>
  </div>
  
  <p class="meta">
    <span class="site-time">已运行 {daysRunning} 天</span>
    <span class="separator">|</span>
    <span class="countdown">十年之约还剩 {daysRemaining} 天</span>
  </p>
  
  <p class="meta">
    © {startYear}-{currentYear} <a href={siteConfig.url} target="_blank" rel="noopener">{siteConfig.title}</a>
    <span class="separator">|</span>
    Powered by <a href="https://astro.build" target="_blank" rel="noopener">Astro</a>
    <span class="separator">|</span>
    Theme by <a href={siteConfig.author} target="_blank" rel="noopener">Hacker</a>
  </p>
</footer>

<style>
  .footer-social {
    display: flex;
    justify-content: center;
    gap: 1rem;
    margin-bottom: 1rem;
  }
  
  .social-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    color: #9e9e9e;
    transition: color 0.3s ease;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
    margin: 0;
    text-decoration: none;
    font-size: 16px;
  }
  
  .social-icon:focus {
    outline: none;
  }
  
  #theme-toggle {
    font-size: inherit;
    font-family: inherit;
    background: transparent;
    border: none;
    box-shadow: none;
  }
  
  .social-icon:hover {
    color: #F03838;
  }
  
  body.dark .social-icon {
    color: #9e9e9e;
  }
  
  body.dark .social-icon:hover {
    color: #F03838;
  }
  
  .separator {
    margin: 0 0.5rem;
    color: #e0e0e0;
  }
  
  .site-time, .countdown {
    color: #9e9e9e;
    font-size: 13px;
  }
  
  .site-footer .meta {
    color: #9e9e9e;
  }
  
  .site-footer .meta a {
    color: #9e9e9e;
  }
  
  .site-footer .meta a:hover {
    color: #F03838;
  }
  
  body.dark .site-footer .meta a:hover {
    color: #F03838;
  }
  
  #theme-toggle i {
    position: absolute;
    transition: opacity 0.3s ease;
  }
  
  #theme-toggle .fa-sun {
    opacity: 0;
  }
  
  body.dark #theme-toggle .fa-moon {
    opacity: 0;
  }
  
  body.dark #theme-toggle .fa-sun {
    opacity: 1;
  }
</style>

<script>
  // 日夜模式切换功能
  const themeToggle = document.getElementById('theme-toggle');
  const body = document.body;
  
  // 检查本地存储中的主题设置
  if (localStorage.getItem('theme') === 'dark' || (!localStorage.getItem('theme') && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
    body.classList.add('dark');
  } else {
    body.classList.remove('dark');
  }
  
  // 切换主题
  themeToggle.addEventListener('click', () => {
    body.classList.toggle('dark');
    localStorage.setItem('theme', body.classList.contains('dark') ? 'dark' : 'light');
  });
</script>
