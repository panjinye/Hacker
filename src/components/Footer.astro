---
// Footer组件
import { siteConfig } from '../config/site';

const currentYear = new Date().getFullYear();
const buildDate = new Date(siteConfig.buildDate);
const startYear = buildDate.getFullYear();
const now = new Date();
const daysRunning = Math.floor((now.getTime() - buildDate.getTime()) / (1000 * 60 * 60 * 24));

const targetDate = new Date(buildDate.getFullYear() + 10, 0, 1);
const daysRemaining = Math.ceil((targetDate.getTime() - now.getTime()) / (1000 * 60 * 60 * 24));
---

<footer class="site-footer">
  <div class="footer-social">
    {siteConfig.social.github && (
      <a href={siteConfig.social.github} target="_blank" rel="noopener noreferrer" class="social-icon" title="GitHub">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
        </svg>
      </a>
    )}
    {siteConfig.social.twitter && (
      <a href={siteConfig.social.twitter} target="_blank" rel="noopener noreferrer" class="social-icon" title="Twitter">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
          <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
        </svg>
      </a>
    )}
    {siteConfig.social.mastodon && (
      <a href={siteConfig.social.mastodon} target="_blank" rel="noopener noreferrer" class="social-icon" title="Mastodon">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
          <path d="M18.64 7.5c-.7 0-1.27.57-1.27 1.27 0 .7.57 1.27 1.27 1.27.7 0 1.27-.57 1.27-1.27 0-.7-.57-1.27-1.27-1.27zm-2.14-3.23c-.81 0-1.47.66-1.47 1.47 0 .81.66 1.47 1.47 1.47.81 0 1.47-.66 1.47-1.47 0-.81-.66-1.47-1.47-1.47zm-2.46 9.09c-.51 0-.92-.41-.92-.92 0-.51.41-.92.92-.92.51 0 .92.41.92.92 0 .51-.41.92-.92.92zm-4.92-9.09c-.81 0-1.47.66-1.47 1.47 0 .81.66 1.47 1.47 1.47.81 0 1.47-.66 1.47-1.47 0-.81-.66-1.47-1.47-1.47zm-2.14 3.23c-.7 0-1.27.57-1.27 1.27 0 .7.57 1.27 1.27 1.27.7 0 1.27-.57 1.27-1.27 0-.7-.57-1.27-1.27-1.27zm8.5 9.09c-.51 0-.92-.41-.92-.92 0-.51.41-.92.92-.92.51 0 .92.41.92.92 0 .51-.41.92-.92.92zm-4.25-6.14c-3.06 0-5.55 1.93-6.34 4.58-.2.59-.31 1.21-.31 1.85 0 2.16 2.55 3.91 5.7 3.91 3.15 0 5.7-1.75 5.7-3.91 0-.64-.11-1.26-.31-1.85-.79-2.65-3.28-4.58-6.34-4.58zm-3.51 4.53c0-.89.44-1.68 1.13-2.14.69-.46 1.51-.69 2.38-.69s1.69.23 2.38.69c.69.46 1.13 1.25 1.13 2.14 0 1.32-1.63 2.39-3.65 2.39-2.02 0-3.65-1.07-3.65-2.39z"/>
        </svg>
      </a>
    )}
    {siteConfig.social.qq && (
      <a href={siteConfig.social.qq} target="_blank" rel="noopener noreferrer" class="social-icon" title="QQ">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 0C5.37 0 0 5.37 0 12s5.37 12 12 12 12-5.37 12-12S18.63 0 12 0zm0 22C6.48 22 2 17.52 2 12S6.48 2 12 2s10 4.48 10 10-4.48 10-10 10zm-2-10c0 1.1.9 2 2 2s2-.9 2-2-.9-2-2-2-2 .9-2 2z"/>
        </svg>
      </a>
    )}
    {siteConfig.social.email && (
      <a href={siteConfig.social.email} class="social-icon" title="Email">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
          <path d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/>
        </svg>
      </a>
    )}
  </div>
  
  <p class="meta">
    <span class="site-time">已运行 {daysRunning} 天</span>
    <span class="separator">|</span>
    <span class="countdown">十年之约还剩 {daysRemaining} 天</span>
  </p>
  
  <p class="meta">
    © {startYear}-{currentYear} <a href={siteConfig.url} target="_blank" rel="noopener">{siteConfig.title}</a>
    <span class="separator">|</span>
    Powered by <a href="https://astro.build" target="_blank" rel="noopener">Astro</a>
    <span class="separator">|</span>
    Theme by <a href={siteConfig.author} target="_blank" rel="noopener">Hacker</a>
  </p>
</footer>

<style>
  .footer-social {
    display: flex;
    justify-content: center;
    gap: 1rem;
    margin-bottom: 1rem;
  }
  
  .social-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    color: #9e9e9e;
    transition: color 0.3s ease;
  }
  
  .social-icon:hover {
    color: #F03838;
  }
  
  .separator {
    margin: 0 0.5rem;
    color: #e0e0e0;
  }
  
  .site-time, .countdown {
    color: #9e9e9e;
    font-size: 13px;
  }
  
  .site-footer .meta {
    color: #9e9e9e;
  }
  
  .site-footer .meta a {
    color: #9e9e9e;
  }
  
  .site-footer .meta a:hover {
    color: #F03838;
  }
</style>
